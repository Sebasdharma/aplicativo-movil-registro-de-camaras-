# Copia este archivo como ".env" (en esta misma carpeta) y completa los valores.
# El archivo .env NO se sube a GitHub: contiene la contraseña de la base de datos.

# Cadena de conexión de Supabase (Project Settings -> Database -> Connection string).
# Usa la opción "Session pooler" (funciona en redes sin IPv6). Reemplaza
# [YOUR-PASSWORD] por la contraseña del proyecto; si tiene símbolos como @ # / :
# escríbelos codificados (@ = %40, # = %23, / = %2F, : = %3A).
# Si dejas esta línea vacía o comentada, el sistema usa SQLite local (data/buhopass.db).
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CONTRASENA@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# Opcional: máximo de conexiones simultáneas del backend (por defecto 5).
# ASISTECH_DB_POOL_MAX=5
