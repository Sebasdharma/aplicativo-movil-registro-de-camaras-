<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar Superior -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarAsistencia"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/upec_green"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="Toma de Asistencia"
            app:titleTextColor="@color/white" />

        <!-- Encabezado de la Clase -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvClaseTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplicaciones Móviles - Paralelo A"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClaseInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Aula 402 • 08:00 AM - 09:30 AM"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <!-- Contador en Vivo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_tomada"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvContadorAsistencia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Presentes: 4 / 4 Estudiantes Registrados"
                    android:textColor="@color/upec_green_badge_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSincronizarCamara"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_btn_gold"
                    android:paddingHorizontal="12dp"
                    android:text="Escanear Facial"
                    android:textAllCaps="false"
                    android:textColor="#1F2937"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lista de Estudiantes -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEstudiantesAsistencia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
