<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Avatar / Iniciales -->
    <TextView
        android:id="@+id/tvAvatarInitials"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_metric"
        android:gravity="center"
        android:text="SR"
        android:textColor="@color/upec_green_badge_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Datos del Estudiante -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreEstudiante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sebastián Reina"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCodigoEstudiante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="UPEC-001 • Ing. Computación"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Badge Estado de Asistencia -->
    <TextView
        android:id="@+id/tvEstadoAsistencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_tomada"
        android:text="PRESENTE"
        android:textColor="@color/upec_green_badge_text"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
